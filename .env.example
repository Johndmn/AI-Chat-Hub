# =====================================================================
# Шаблон настроек бесплатного Демо-режима (.env.example)
# ВНИМАНИЕ: Не вставляйте реальный ключ в этот файл (.env.example попадает в Git)!
# Скопируйте этот файл в .env (локально) или вставьте в Streamlit Cloud -> Secrets
# =====================================================================

# Ключ бесплатного провайдера для гостей (например, Groq gsk_... или OpenRouter sk-or-...)
DEMO_API_KEY=

# Base URL провайдера для демо-режима:
# - Groq:       https://api.groq.com/openai/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
# - DeepSeek:   https://api.deepseek.com
DEMO_BASE_URL=https://api.groq.com/openai/v1

# Бесплатная модель по умолчанию для демо-режима
# Актуальные модели Groq: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
# Пример для OpenRouter: deepseek/deepseek-chat-v3-0324:free
DEMO_MODEL_NAME=openai/gpt-oss-120b

# Общий дневной лимит бесплатных запросов НА ВСЕХ пользователей (сбрасывается каждые 24 часа)
DEMO_DAILY_GLOBAL_LIMIT=100

# Лимит бесплатных запросов на одну пользовательскую сессию
DEMO_SESSION_LIMIT=15

# Температура генерации по умолчанию (от 0.0 до 1.0)
OPENAI_TEMPERATURE=0.7
