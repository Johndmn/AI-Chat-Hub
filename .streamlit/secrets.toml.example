# Шаблон секретов Streamlit Cloud (.streamlit/secrets.toml)
# Скопируйте этот файл в .streamlit/secrets.toml и вставьте реальные значения.
# НЕ добавляйте .streamlit/secrets.toml в Git — файл уже указан в .gitignore.

# Ключ бесплатного провайдера для гостей (Groq gsk_... или OpenRouter sk-or-v...)
DEMO_API_KEY = ""

# Base URL провайдера для демо-режима:
# - Groq:       https://api.groq.com/openai/v1
# - OpenRouter: https://openrouter.ai/api/v1
DEMO_BASE_URL = "https://api.groq.com/openai/v1"

# Бесплатная модель по умолчанию для демо-режима
DEMO_MODEL_NAME = "openai/gpt-oss-120b"

# Общий дневной лимит бесплатных запросов на всех пользователей
DEMO_DAILY_GLOBAL_LIMIT = "100"

# Лимит бесплатных запросов на одну пользовательскую сессию
DEMO_SESSION_LIMIT = "15"

# Температура генерации по умолчанию (0.0 — 1.0)
OPENAI_TEMPERATURE = "0.7"
